<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fillViewport="true"
    android:scrollbars="none"
    android:clipToPadding="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/page_title" android:textSize="24sp"
            android:textStyle="bold" android:textColor="@color/text_primary" />
        <TextView style="@style/SectionLabel" android:text="@string/mode_label" />
        <RadioGroup android:id="@+id/mode_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:checkedButton="@id/mode_java">
            <RadioButton android:id="@+id/mode_java" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/mode_java" />
            <RadioButton android:id="@+id/mode_native" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/mode_native" />
        </RadioGroup>
        <TextView style="@style/SectionLabel" android:text="@string/scenario_label" />
        <Spinner android:id="@+id/scenario" android:layout_width="match_parent"
            android:layout_height="56dp" android:spinnerMode="dialog"
            android:prompt="@string/scenario_label" />
        <TextView android:id="@+id/scenario_details" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textColor="@color/text_secondary" android:paddingTop="8dp" />
        <TextView style="@style/SectionLabel" android:text="@string/thread_label" />
        <RadioGroup android:id="@+id/thread_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:checkedButton="@id/thread_main">
            <RadioButton android:id="@+id/thread_main" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/thread_main" />
            <RadioButton android:id="@+id/thread_background" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/thread_background" />
        </RadioGroup>
        <TextView style="@style/SectionLabel" android:text="@string/run_id_label" />
        <EditText android:id="@+id/run_id" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:inputType="textNoSuggestions" android:singleLine="true"
            android:hint="@string/run_id_hint" android:importantForAutofill="no" />
        <Button android:id="@+id/trigger" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:layout_marginTop="24dp" android:text="@string/trigger"
            android:textColor="@color/danger" />
        <TextView style="@style/SectionLabel" android:text="@string/last_run_label" />
        <TextView android:id="@+id/last_run" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="@string/no_last_run" android:textSize="14sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</ScrollView>
